@page "/cart"
@inject ContosoShop.Cart.ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<h1>Shopping cart</h1>
<p>Your selections stay with you while browsing. Refreshing or restarting may clear your cart.</p>
<p>Adjust quantities below. Each product must have a quantity of at least one.</p>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
else
{
    <div class="cart-panel">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ShoppingCart.Items)
                    {
                        <tr @key="item.Product.Id">
                            <th scope="row">@item.Product.Name</th>
                            <td>@item.Product.Price.ToString("C")</td>
                            <td>
                                <div class="quantity-controls">
                                    <button type="button" class="btn btn-outline-success btn-sm"
                                            aria-label="Decrease quantity of @item.Product.Name"
                                            disabled="@(item.Quantity == 1)"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                    <span class="quantity-value" aria-live="polite">@item.Quantity</span>
                                    <button type="button" class="btn btn-outline-success btn-sm"
                                            aria-label="Increase quantity of @item.Product.Name"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, checked(item.Quantity + 1))">+</button>
                                </div>
                            </td>
                            <td>@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="cart-total">Cart total: @ShoppingCart.Total.ToString("C")</p>
        <a class="btn btn-primary" href="products">Continue shopping</a>
    </div>
}