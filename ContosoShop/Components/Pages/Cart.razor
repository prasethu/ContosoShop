@page "/cart"
@using ContosoShop.Shopping
@inject ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<h1>Shopping cart</h1>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty. Find something for your everyday routine.</p>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
else
{
    <div class="cart-panel">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Unit price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Line total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ShoppingCart.Items)
                {
                    <tr @key="item.Product.Id">
                        <th scope="row">@item.Product.Name</th>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>
                            <div class="quantity-controls">
                                <button type="button" class="btn btn-outline-secondary" aria-label="Decrease quantity of @item.Product.Name"
                                        disabled="@(item.Quantity == 1)" @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                <span class="quantity-value">@item.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary" aria-label="Increase quantity of @item.Product.Name"
                                        disabled="@(item.Quantity == int.MaxValue)" @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, checked(item.Quantity + 1))">+</button>
                            </div>
                        </td>
                        <td>@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="cart-total">Cart total: @ShoppingCart.Total.ToString("C")</p>
    </div>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}