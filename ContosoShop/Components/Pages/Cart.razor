@page "/cart"
@using ContosoShop.Cart
@inject ShoppingCart ShoppingCart

<PageTitle>Cart</PageTitle>

<header class="cart-header">
    <h1>Your cart</h1>
    <p>Your selections stay with you while you browse. Refreshing or restarting starts a new cart.</p>
    <p>Use the quantity controls to adjust your selections. Each item has a minimum quantity of one.</p>
</header>

@if (ShoppingCart.Items.Count == 0)
{
    <section class="cart-panel">
        <h2>Your cart is empty</h2>
        <p>Find something useful for your everyday routine.</p>
        <a class="btn btn-primary" href="products">Continue shopping</a>
    </section>
}
else
{
    <section class="cart-panel" aria-label="Cart items">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ShoppingCart.Items)
                    {
                        <tr @key="item.Product.Id">
                            <th scope="row">@item.Product.Name</th>
                            <td>@item.Product.Price.ToString("C")</td>
                            <td>
                                <div class="quantity-controls">
                                    <button type="button" class="btn btn-outline-secondary"
                                            aria-label="@($"Decrease quantity of {item.Product.Name}")"
                                            disabled="@(item.Quantity <= 1)"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                    <span aria-label="@($"Quantity of {item.Product.Name}")">@item.Quantity</span>
                                    <button type="button" class="btn btn-outline-secondary"
                                            aria-label="@($"Increase quantity of {item.Product.Name}")"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, checked(item.Quantity + 1))">+</button>
                                </div>
                            </td>
                            <td>@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="cart-total" aria-live="polite">Cart total (USD): @ShoppingCart.Total.ToString("C")</p>
        <a class="btn btn-primary" href="products">Continue shopping</a>
    </section>
}