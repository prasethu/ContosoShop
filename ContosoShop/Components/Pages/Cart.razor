@page "/cart"
@inject ContosoShop.Cart.ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<h1>Shopping cart</h1>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty. Find something for your everyday routine.</p>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
else
{
    <div class="table-responsive cart-items">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Unit price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Line total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ShoppingCart.Items)
                {
                    <tr @key="item.Product.Id">
                        <th scope="row">@item.Product.Name</th>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>
                            <div class="d-inline-flex align-items-center gap-2" role="group" aria-label="Quantity for @item.Product.Name">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="Decrease quantity for @item.Product.Name"
                                        disabled="@(item.Quantity == 1)"
                                        @onclick="() => ShoppingCart.DecreaseQuantity(item.Product.Id)">-</button>
                                <span aria-live="polite">@item.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="Increase quantity for @item.Product.Name"
                                        @onclick="() => ShoppingCart.IncreaseQuantity(item.Product.Id)">+</button>
                            </div>
                        </td>
                        <td>@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="3">Cart total</th>
                    <td><strong>@ShoppingCart.Total.ToString("C")</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
