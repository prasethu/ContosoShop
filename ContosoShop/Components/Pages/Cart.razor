@page "/cart"
@using ContosoShop.Shopping
@inject ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<header class="cart-header">
    <h1>Your shopping cart</h1>
    <p>Review your everyday finds.</p>
</header>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
else
{
    <div class="cart-content">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ShoppingCart.Items)
                    {
                        <tr @key="item.Product.Id">
                            <th scope="row">@item.Product.Name</th>
                            <td>@item.Product.Price.ToString("C")</td>
                            <td>
                                <div class="quantity-controls">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            aria-label="Decrease quantity for @item.Product.Name"
                                            disabled="@(item.Quantity <= 1)"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                    <span aria-label="Quantity for @item.Product.Name">@item.Quantity</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            aria-label="Increase quantity for @item.Product.Name"
                                            disabled="@(item.Quantity == int.MaxValue)"
                                            @onclick="() => ShoppingCart.SetQuantity(item.Product.Id, checked(item.Quantity + 1))">+</button>
                                </div>
                            </td>
                            <td>@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="cart-total">Cart total: @ShoppingCart.Total.ToString("C")</p>
        <a href="products">Continue shopping</a>
    </div>
}