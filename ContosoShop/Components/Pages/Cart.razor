@page "/cart"
@inject ContosoShop.Shopping.ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<header class="cart-header">
    <h1>Your cart</h1>
    <a href="products">Continue shopping</a>
</header>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty. Browse our products to find something for your day.</p>
}
else
{
    <div class="cart-table">
        <table>
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Unit price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Line total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ShoppingCart.Items)
                {
                    <tr @key="item.Product.Id">
                        <th scope="row">@item.Product.Name</th>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>
                            <div class="quantity-controls">
                                <button aria-label="@($"Decrease quantity of {item.Product.Name}")"
                                        disabled="@(item.Quantity <= 1)"
                                        @onclick="() => ShoppingCart.DecreaseQuantity(item.Product.Id)">-</button>
                                <span aria-label="@($"Quantity of {item.Product.Name}")">@item.Quantity</span>
                                <button aria-label="@($"Increase quantity of {item.Product.Name}")"
                                        @onclick="() => ShoppingCart.IncreaseQuantity(item.Product.Id)">+</button>
                            </div>
                        </td>
                        <td>@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="cart-total">Cart total: @ShoppingCart.Total.ToString("C")</p>
}