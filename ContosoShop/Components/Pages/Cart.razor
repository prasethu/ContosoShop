@page "/cart"
@using ContosoShop.Cart
@inject ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<header class="cart-header">
    <h1>Your shopping cart</h1>
    <a href="products">Continue shopping</a>
</header>

@if (ShoppingCart.Items.Count == 0)
{
    <div class="cart-panel">
        <p>Your cart is empty. Browse the collection to find your everyday essentials.</p>
        <a class="btn btn-primary" href="products">Browse products</a>
    </div>
}
else
{
    <div class="cart-panel">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Line total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ShoppingCart.Items)
                    {
                        <tr @key="item.Product.Id">
                            <th scope="row">@item.Product.Name</th>
                            <td>@item.Product.Price.ToString("C")</td>
                            <td>
                                <div class="d-inline-flex align-items-center gap-2" role="group" aria-label="@(item.Product.Name + " quantity")">
                                    <button type="button" class="btn btn-outline-success btn-sm"
                                            aria-label="@("Decrease quantity of " + item.Product.Name)"
                                            disabled="@(item.Quantity <= 1)" @onclick="item.DecreaseQuantity">-</button>
                                    <span aria-live="polite">@item.Quantity</span>
                                    <button type="button" class="btn btn-outline-success btn-sm"
                                            aria-label="@("Increase quantity of " + item.Product.Name)"
                                            @onclick="item.IncreaseQuantity">+</button>
                                </div>
                            </td>
                            <td>@item.LineTotal.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="cart-total">Cart total: @ShoppingCart.Total.ToString("C")</p>
    </div>
}