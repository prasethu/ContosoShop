@page "/cart"
@using ContosoShop.Cart
@inject ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<h1>Your cart</h1>

@if (ShoppingCart.Lines.Count == 0)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" href="products">Continue shopping</a>
}
else
{
    <div class="cart-table-wrapper">
        <table class="table cart-table">
            <caption class="visually-hidden">Selected products and their costs</caption>
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Unit price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Line total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in ShoppingCart.Lines)
                {
                    <tr @key="line.Product.Id">
                        <th scope="row">@line.Product.Name</th>
                        <td>@line.Product.Price.ToString("C")</td>
                        <td>
                            <div class="quantity-controls">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="Decrease quantity of @line.Product.Name"
                                        disabled="@(line.Quantity == 1)"
                                        @onclick="() => ShoppingCart.DecreaseQuantity(line.Product.Id)">-</button>
                                <span class="quantity-value" aria-live="polite">@line.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="Increase quantity of @line.Product.Name"
                                        disabled="@(line.Quantity == int.MaxValue)"
                                        @onclick="() => ShoppingCart.IncreaseQuantity(line.Product.Id)">+</button>
                            </div>
                        </td>
                        <td class="line-total">@line.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="cart-total">Cart total: <strong>@ShoppingCart.Total.ToString("C")</strong></p>
    <a href="products">Continue shopping</a>
}