@page "/cart"
@using ContosoShop.Shopping
@inject ShoppingCart ShoppingCart

<PageTitle>Shopping cart</PageTitle>

<header class="cart-header">
    <h1>Your shopping cart</h1>
    <a href="products">Continue shopping</a>
</header>

@if (ShoppingCart.Items.Count == 0)
{
    <p>Your cart is empty. Browse our products to find your everyday essentials.</p>
}
else
{
    <div class="cart-items">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Unit price</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Line total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ShoppingCart.Items)
                {
                    <tr @key="item.Product.Id">
                        <th scope="row">@item.Product.Name</th>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>
                            <div class="quantity-controls">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="@($"Decrease quantity of {item.Product.Name}")"
                                        disabled="@(item.Quantity <= 1 || !RendererInfo.IsInteractive)"
                                        @onclick="() => ShoppingCart.DecreaseQuantity(item.Product.Id)">-</button>
                                <span>@item.Quantity</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        aria-label="@($"Increase quantity of {item.Product.Name}")"
                                        disabled="@(!RendererInfo.IsInteractive)"
                                        @onclick="() => ShoppingCart.IncreaseQuantity(item.Product.Id)">+</button>
                            </div>
                        </td>
                        <td>@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="cart-total">Cart total (USD): @ShoppingCart.Total.ToString("C")</p>
    </div>
}