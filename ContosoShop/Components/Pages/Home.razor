@page "/"

<PageTitle>ContosoShop</PageTitle>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">Thoughtful everyday essentials</p>
        <h1>Simple finds for work, home, and everywhere between.</h1>
        <p class="hero-description">
            Explore a small collection of practical products selected for daily routines and weekend plans.
        </p>
        <a class="browse-link" href="products">Browse products <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="hero-image" aria-hidden="true">
        <img src="/images/products/backpack.jpg" alt="" />
        <div class="hero-note">
            <span>Featured</span>
            <strong>Everyday Backpack</strong>
        </div>
    </div>
</section>

<section class="store-promises" aria-label="Store highlights">
    <article>
        <span class="promise-number">01</span>
        <div>
            <h2>Useful by design</h2>
            <p>Every item has a clear place in an everyday routine.</p>
        </div>
    </article>
    <article>
        <span class="promise-number">02</span>
        <div>
            <h2>Small collection</h2>
            <p>A focused catalog that is easy to browse and understand.</p>
        </div>
    </article>
    <article>
        <span class="promise-number">03</span>
        <div>
            <h2>Ready to explore</h2>
            <p>Start with the products and discover what fits your day.</p>
        </div>
    </article>
</section>
