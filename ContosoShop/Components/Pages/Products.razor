@page "/products"
@using ContosoShop.Catalog
@using ContosoShop.Cart
@inject IProductCatalog ProductCatalog
@inject ShoppingCart ShoppingCart

<PageTitle>Products</PageTitle>

<header class="catalog-header">
    <div>
        <p class="eyebrow">The collection</p>
        <h1>Everyday products, thoughtfully selected.</h1>
    </div>
    <p>Six practical finds for your workspace, home, and next day out.</p>
</header>

<p role="status">@statusMessage</p>

<div class="product-grid">
    @foreach (var product in products)
    {
        <article class="product-card">
            <div class="product-image">
                <img src="@product.ImageUrl" alt="@product.Name" />
            </div>
            <div class="product-body">
                <p class="product-category">@product.Category</p>
                <div class="product-heading">
                    <h2>@product.Name</h2>
                    <p class="product-price">@product.Price.ToString("C")</p>
                </div>
                <p class="product-description">@product.Description</p>
                <button type="button" class="btn btn-primary mt-3" aria-label="Add @product.Name to cart"
                        @onclick="() => AddToCart(product)">Add to cart</button>
            </div>
        </article>
    }
</div>

@code {
    private IReadOnlyList<Product> products = [];
    private string? statusMessage;

    private void AddToCart(Product product)
    {
        ShoppingCart.Add(product);
        statusMessage = $"Added {product.Name} to your cart.";
    }

    protected override void OnInitialized()
    {
        products = ProductCatalog.GetProducts();
    }
}
